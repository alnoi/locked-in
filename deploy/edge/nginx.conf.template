load_module /usr/lib/nginx/modules/ngx_http_js_module.so;
user nginx;
worker_processes 2;
pid /var/run/nginx.pid;
error_log /var/log/nginx/error.log warn;
events { worker_connections 1024; }
http {
  js_import guard from /etc/nginx/guard.js;
  js_shared_dict_zone zone=trackit_bans:16m type=number timeout=10m evict;
  js_shared_dict_zone zone=trackit_failures:8m type=number timeout=2m evict;
  server_tokens off;
  default_type application/json;
  client_max_body_size 1m;
  client_header_timeout 10s;
  client_body_timeout 10s;
  send_timeout 15s;
  keepalive_timeout 15s;
  reset_timedout_connection on;
  limit_req_zone $binary_remote_addr zone=per_ip:10m rate=10r/s;
  limit_req_zone $binary_remote_addr zone=auth_ip:10m rate=20r/m;
  limit_req_zone $server_name zone=auth_total:1m rate=60r/m;
  limit_req_zone $server_name zone=total:1m rate=100r/s;
  limit_conn_zone $binary_remote_addr zone=connections_ip:10m;
  limit_conn_zone $server_name zone=connections_total:1m;
  limit_req_status 429;
  limit_conn_status 429;
  map $uri $request_kind {
    default api;
    /api/v1/auth/login auth;
    /api/v1/auth/register auth;
  }
  map "$status:$request_kind" $record_abuse {
    default 0;
    ~^429: 1;
    ~^404: 1;
    "401:auth" 1;
  }
  log_format abuse '$time_iso8601 $remote_addr $status $request_kind';
  access_log /var/log/nginx/abuse.log abuse if=$record_abuse;
  server {
    listen 127.0.0.1:8081;
    access_log off;
    location = /livez { return 204; }
    location = /bans { js_content guard.admin; }
    location / { return 404; }
  }
  server {
    listen 80 default_server;
    server_name __PUBLIC_HOST__;
    location ^~ /.well-known/acme-challenge/ {
      root /var/www/certbot;
      default_type text/plain;
      try_files $uri =404;
    }
    location / { return 308 https://__PUBLIC_HOST__$request_uri; }
  }
  server {
    listen 443 ssl default_server;
    server_name __PUBLIC_HOST__;
    ssl_certificate /etc/letsencrypt/live/trackit/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/trackit/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    limit_req zone=per_ip burst=60 nodelay;
    limit_req zone=total burst=120 nodelay;
    limit_conn connections_ip 20;
    limit_conn connections_total 100;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 3s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;
    proxy_buffering on;
    auth_request /_trackit_guard;
    error_page 403 = @blocked;
    error_page 429 = @rate_limited;
    error_page 400 405 413 414 431 = @invalid_request;
    error_page 404 = @not_found;
    error_page 500 502 503 504 = @unavailable;
    location = /_trackit_guard {
      internal;
      auth_request off;
      js_content guard.check;
    }
    location @blocked {
      auth_request off;
      js_content guard.blocked;
    }
    location @rate_limited {
      auth_request off;
      js_content guard.rateLimited;
    }
    location @invalid_request {
      return 400 '{"code":"validation_error","message":"Check the request fields and try again."}';
    }
    location @not_found {
      return 404 '{"code":"not_found","message":"The requested item is no longer available."}';
    }
    location @unavailable {
      return 503 '{"code":"server_unavailable","message":"No connection with server. Please try again later."}';
    }
    location ~ ^/api/v1/auth/(login|register)$ {
      js_header_filter guard.recordResponse;
      limit_req zone=auth_ip burst=5 nodelay;
      limit_req zone=auth_total burst=10 nodelay;
      limit_req zone=total burst=120 nodelay;
      proxy_pass http://127.0.0.1:8080;
    }
    location /api/v1/ { proxy_pass http://127.0.0.1:8080; }
    location = /readyz { proxy_pass http://127.0.0.1:8080; }
    location = /livez { proxy_pass http://127.0.0.1:8080; }
    location / { js_content guard.notFound; }
  }
}
